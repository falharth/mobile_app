[app]

# App info
title = Faisal Trading App
package.name = faisaltradingapp
package.domain = com.faisal

# Source
source.dir = .
source.include_exts = py,png,jpg,kv,atlas

# Version
version = 1.0

# Requirements (Python packages the app needs)
requirements = python3,kivy

# Orientation
orientation = portrait

# iOS specific settings
ios.kivy_ios_url = https://github.com/kivy/kivy-ios
ios.kivy_ios_branch = master
ios.ios_deploy_url = https://github.com/nicklockwood/iVersion
ios.ios_deploy_branch = master

# App icon (place a 1024x1024 icon.png in app folder)
# icon.filename = icon.png

# Fullscreen mode
fullscreen = 1

# Permissions
# ios.permissions = CAMERA
